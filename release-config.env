# ============================================================================
# Edam — Editable Multi-Platform Release Configuration
# ============================================================================
# Edit the values below whenever you want to publish a new version of Edam
# for Android (.apk), Windows (.msi / .jar), macOS (.dmg / .jar), and Linux (.deb / .jar).
# Pushing a commit that updates RELEASE_TAG (or pushing a git tag like v1.2.0)
# automatically triggers the GitHub Actions workflow (.github/workflows/release-apk.yml)
# to build, upload the APK to the repository's releases/ folder, and create a
# multi-platform GitHub Release.
# ============================================================================

APP_NAME=Edam
APP_VERSION_NAME=1.2.0
APP_VERSION_CODE=3
RELEASE_TAG=v1.2.0
RELEASE_CHANNEL=stable
RELEASE_TITLE=Edam v1.2.0 — Android, Windows, macOS & Linux Release

# Toggle which platform packages to build in GitHub Actions
BUILD_ANDROID_APK=true
BUILD_WINDOWS_PC=true
BUILD_MACOS_PC=true
BUILD_LINUX_PC=true

# Commit the generated Android APK directly into the repository's releases/ directory
UPLOAD_APK_TO_REPO=true
