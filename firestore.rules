rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserAccount(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 254)) &&
             data.planTier is string && (data.planTier in ['BASIC', 'PRO', 'MAX']) &&
             (!('promoCodeUsed' in data) || data.promoCodeUsed == null || (data.promoCodeUsed is string && data.promoCodeUsed.size() <= 64)) &&
             data.themeMode is string && data.themeMode.size() >= 1 && data.themeMode.size() <= 64 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCloudCourse(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.level is string && data.level.size() >= 1 && data.level.size() <= 64 &&
             data.goal is string && data.goal.size() >= 1 && data.goal.size() <= 1000 &&
             data.courseJson is string && data.courseJson.size() >= 2 && data.courseJson.size() <= 200000 &&
             data.completedLessonsJson is string && data.completedLessonsJson.size() >= 2 && data.completedLessonsJson.size() <= 50000 &&
             data.offlineLessonsJson is string && data.offlineLessonsJson.size() >= 2 && data.offlineLessonsJson.size() <= 700000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDailyStreak(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 100000 &&
             data.longestStreak is int && data.longestStreak >= data.currentStreak && data.longestStreak <= 100000 &&
             data.lastStudyEpochDay is int && data.lastStudyEpochDay >= 0 && data.lastStudyEpochDay <= 10000000 &&
             data.totalXp is int && data.totalXp >= 0 && data.totalXp <= 100000000 &&
             data.weeklyStudyDaysCsv is string && data.weeklyStudyDaysCsv.size() >= 1 && data.weeklyStudyDaysCsv.size() <= 32 &&
             data.streakFreezeActive is bool &&
             data.streakFreezesAvailable is int && data.streakFreezesAvailable >= 0 && data.streakFreezesAvailable <= 100 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserBadge(data) {
      return data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.badgeKey is string && data.badgeKey.size() >= 1 && data.badgeKey.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 500 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 64 &&
             data.iconKey is string && data.iconKey.size() >= 1 && data.iconKey.size() <= 64 &&
             data.progressPct is int && data.progressPct >= 0 && data.progressPct <= 100 &&
             data.isUnlocked is bool &&
             (!('unlockedAt' in data) || data.unlockedAt == null || data.unlockedAt is int) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'planTier', 'themeMode', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'planTier', 'promoCodeUsed', 'themeMode', 'createdAt', 'updatedAt']) &&
                       isValidUserAccount(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserAccount(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'planTier', 'promoCodeUsed', 'themeMode', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /courses/{courseId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(courseId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId && resource.data.userId == request.auth.uid;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(courseId) &&
                         request.auth.uid == userId &&
                         incoming().id == courseId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['id', 'userId', 'title', 'level', 'goal', 'courseJson', 'completedLessonsJson', 'offlineLessonsJson', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['id', 'userId', 'title', 'level', 'goal', 'courseJson', 'completedLessonsJson', 'offlineLessonsJson', 'createdAt', 'updatedAt']) &&
                         isValidCloudCourse(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(courseId) &&
                         request.auth.uid == userId &&
                         isValidCloudCourse(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'level', 'goal', 'courseJson', 'completedLessonsJson', 'offlineLessonsJson', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(courseId) && request.auth.uid == userId;
      }

      match /streaks/{streakId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(streakId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId && resource.data.userId == request.auth.uid;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(streakId) &&
                         request.auth.uid == userId &&
                         incoming().id == streakId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['id', 'userId', 'currentStreak', 'longestStreak', 'lastStudyEpochDay', 'totalXp', 'weeklyStudyDaysCsv', 'streakFreezeActive', 'streakFreezesAvailable', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['id', 'userId', 'currentStreak', 'longestStreak', 'lastStudyEpochDay', 'totalXp', 'weeklyStudyDaysCsv', 'streakFreezeActive', 'streakFreezesAvailable', 'createdAt', 'updatedAt']) &&
                         isValidDailyStreak(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(streakId) &&
                         request.auth.uid == userId &&
                         isValidDailyStreak(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['currentStreak', 'longestStreak', 'lastStudyEpochDay', 'totalXp', 'weeklyStudyDaysCsv', 'streakFreezeActive', 'streakFreezesAvailable', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(streakId) && request.auth.uid == userId;
      }

      match /badges/{badgeId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(badgeId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId && resource.data.userId == request.auth.uid;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(badgeId) &&
                         request.auth.uid == userId &&
                         incoming().id == badgeId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['id', 'userId', 'badgeKey', 'title', 'description', 'category', 'iconKey', 'progressPct', 'isUnlocked', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['id', 'userId', 'badgeKey', 'title', 'description', 'category', 'iconKey', 'progressPct', 'isUnlocked', 'unlockedAt', 'createdAt', 'updatedAt']) &&
                         isValidUserBadge(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(badgeId) &&
                         request.auth.uid == userId &&
                         isValidUserBadge(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'iconKey', 'progressPct', 'isUnlocked', 'unlockedAt', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(badgeId) && request.auth.uid == userId;
      }
    }
  }
}
